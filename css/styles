* {
    box-sizing: border-box;
}
.h1{
    display: flex;
    justify-content: center;
}
.box {
    width: 400px;
    height: 400px;
    border: dotted 10px rgba(0,0,0,9);
    margin: 10% auto;
    padding: 70px;
}
.pratos{
    display: flex;
    justify-content: center;
    gap: 10px;
    padding: 10px;
}
.pratos img{
    width: 180px;
    height: 190px;
    border-radius: 20px;
}
.pratos img:hover{
    transform: scale(1.1);
}
.titulo_prod{
    display: flex;
    justify-content: center;
    gap: 10px;
    font-family: Calibri;
    font-size: 12px;
    font-weight: bold;
    color: darkblue;
}
.descricao_prod{
     display: flex;
    justify-content: center;
    gap: 10px;
    font-family: Calibri;
    font-size: 12px;
    text-align  : center;
    color: darkblue;
}
